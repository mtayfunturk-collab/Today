{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://today.local/contracts/context-build-request.schema.json",
  "title": "Today Context Build Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "purpose",
    "requestedAt",
    "window",
    "consent",
    "events"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._:-]{0,158}[a-z0-9])?$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "maxEventsPerSource"],
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "maxEventsPerSource": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        }
      }
    },
    "consent": {
      "$ref": "data-usage-consent.schema.json"
    },
    "events": {
      "type": "array",
      "maxItems": 1098,
      "items": {
        "$ref": "input-event.schema.json"
      }
    }
  }
}
