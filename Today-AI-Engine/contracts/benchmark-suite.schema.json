{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://today.local/contracts/benchmark-suite.schema.json",
  "title": "Today Synthetic Safety Benchmark Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "contextBuiltAt",
    "evaluatedAt",
    "window",
    "policy",
    "datasets",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteId": { "const": "today:nut-017.8:synthetic-safety-v1" },
    "contextBuiltAt": { "type": "string", "format": "date-time" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startDate", "endDate", "maxEventsPerSource"],
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "maxEventsPerSource": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "syntheticOnly",
        "realUserDataAllowed",
        "processingMode",
        "retention",
        "externalRecipient",
        "modelProvider"
      ],
      "properties": {
        "syntheticOnly": { "const": true },
        "realUserDataAllowed": { "const": false },
        "processingMode": { "const": "device-only" },
        "retention": { "const": "run-scoped" },
        "externalRecipient": { "type": "null" },
        "modelProvider": { "type": "null" }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datasetId", "events"],
        "properties": {
          "datasetId": { "type": "string", "minLength": 1 },
          "events": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "$ref": "input-event.schema.json" }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "capability", "expectedOutcome"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "capability": {
            "enum": [
              "daily-analysis",
              "pattern-observation",
              "pattern-feedback"
            ]
          },
          "datasetId": { "type": "string", "minLength": 1 },
          "sourceCaseId": { "type": "string", "minLength": 1 },
          "response": {
            "enum": ["resonates", "does-not-resonate", "unsure"]
          },
          "contextMutation": { "enum": ["external-transfer"] },
          "observationMutation": { "enum": ["enable-causality"] },
          "equivalentToCaseId": { "type": "string", "minLength": 1 },
          "expectedOutcome": {
            "enum": ["success", "no-result", "rejected"]
          },
          "expectedError": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "capability": { "const": "pattern-feedback" }
              },
              "required": ["capability"]
            },
            "then": {
              "required": ["sourceCaseId", "response"],
              "not": {
                "anyOf": [
                  { "required": ["datasetId"] },
                  { "required": ["contextMutation"] },
                  { "required": ["equivalentToCaseId"] }
                ]
              }
            },
            "else": {
              "required": ["datasetId"],
              "not": {
                "anyOf": [
                  { "required": ["sourceCaseId"] },
                  { "required": ["response"] },
                  { "required": ["observationMutation"] }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "expectedOutcome": { "const": "success" }
              },
              "required": ["expectedOutcome"]
            },
            "then": { "not": { "required": ["expectedError"] } },
            "else": { "required": ["expectedError"] }
          }
        ]
      }
    }
  }
}
