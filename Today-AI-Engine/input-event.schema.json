{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://today.local/contracts/input-event.schema.json",
  "title": "Today Input Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "source", "eventType", "createdAt", "localDate", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "source": { "enum": ["today-core", "today-health", "today-sky"] },
    "eventType": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "localDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "payload": { "type": "object" }
  }
}

